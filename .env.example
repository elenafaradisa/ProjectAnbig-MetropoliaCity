# Copy to .env and change the values. Never commit .env.
POSTGRES_USER=metropolia
POSTGRES_PASSWORD=change_me
POSTGRES_DB=metropolia

# Linux: run `id -u` and use that number. Windows/macOS: keep 50000.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_SECRET_KEY=change_me_to_a_long_random_string

# Increase if the transform step runs out of memory (Docker Desktop needs >= 6 GB total).
SPARK_DRIVER_MEMORY=3g
